{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Parrot desktop window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://parrot-web-five.vercel.app/api/v3/**" }]
    },
    "autostart:default",
    "updater:default",
    "process:default"
  ]
}
